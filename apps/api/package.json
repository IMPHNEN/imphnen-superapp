{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types ./worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "arch": "node scripts/check-architecture.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@app/activity": "workspace:*",
    "@app/contract": "workspace:*",
    "@app/messages": "workspace:*",
    "@app/permissions": "workspace:*",
    "@app/schemas": "workspace:*",
    "@app/version": "workspace:*",
    "@mobily/ts-belt": "catalog:",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.40.0"
  }
}
