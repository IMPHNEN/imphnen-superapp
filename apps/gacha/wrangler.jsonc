{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "imphnen-gacha",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "gacha.imphnen.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
