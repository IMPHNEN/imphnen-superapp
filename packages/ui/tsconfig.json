{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.spec.ts",
    "src/**/spec.tsx"
  ]
}
